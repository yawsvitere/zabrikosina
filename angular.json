{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "zabrikosina": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              "allowedHosts": ["198.18.0.1", "198.18.0.1:4200", "localhost", "127.0.0.1"]
            },
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
"serve": {
  "builder": "@angular/build:dev-server",
  "options": {
    "allowedHosts": ["198.18.0.1", "198.18.0.1:4200", "localhost", "127.0.0.1"]
  },
  "configurations": {
    "production": {
      "buildTarget": "zabrikosina:build:production"
    },
    "development": {
      "buildTarget": "zabrikosina:build:development"
    }
  },
  "defaultConfiguration": "development"
},
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
